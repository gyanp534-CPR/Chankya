{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@gyanam/shared": ["packages/shared/src/index.ts"],
      "@core/auth": ["src/core/auth/index.ts"],
      "@core/syllabus": ["src/core/syllabus/index.ts"],
      "@core/question-bank": ["src/core/question-bank/index.ts"],
      "@core/assessment": ["src/core/assessment/index.ts"],
      "@core/mastery": ["src/core/mastery/index.ts"],
      "@core/revision": ["src/core/revision/index.ts"],
      "@core/analytics": ["src/core/analytics/index.ts"],
      "@core/instrumentation": ["src/core/instrumentation/index.ts"],
      "@shared/*": ["src/shared/*"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests", "scripts/manual-error-engine-runner.ts", "eslint.config.js"],
  "exclude": ["dist", "node_modules"]
}
